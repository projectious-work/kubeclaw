FROM debian:trixie-slim AS infra-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /build/bin && \
    TOFU_VERSION="1.12.3" && \
    ARCH="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" && \
    TOFU_ARCHIVE="tofu_${TOFU_VERSION}_linux_${ARCH}.tar.gz" && \
    curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/${TOFU_ARCHIVE}" -o "/tmp/${TOFU_ARCHIVE}" && \
    curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_SHA256SUMS" -o /tmp/tofu_SHA256SUMS && \
    (cd /tmp && grep "${TOFU_ARCHIVE}$" tofu_SHA256SUMS | sha256sum -c -) && \
    tar -xz -C /build/bin -f "/tmp/${TOFU_ARCHIVE}" tofu && \
    rm "/tmp/${TOFU_ARCHIVE}" /tmp/tofu_SHA256SUMS && \
    ARCH="$(dpkg --print-architecture)" && \
    PACKER_VERSION="1.15.4" && \
    PACKER_ARCHIVE="packer_${PACKER_VERSION}_linux_${ARCH}.zip" && \
    curl -fsSL "https://releases.hashicorp.com/packer/${PACKER_VERSION}/${PACKER_ARCHIVE}" \
      -o "/tmp/${PACKER_ARCHIVE}" && \
    curl -fsSL "https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_SHA256SUMS" \
      -o /tmp/packer_SHA256SUMS && \
    (cd /tmp && grep "${PACKER_ARCHIVE}$" packer_SHA256SUMS | sha256sum -c -) && \
    unzip -q "/tmp/${PACKER_ARCHIVE}" -d /build/bin && \
    rm "/tmp/${PACKER_ARCHIVE}" /tmp/packer_SHA256SUMS


# ── Kubernetes builder ────────────────────────────────────────────────
FROM debian:trixie-slim AS k8s-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /build/bin && \
    ARCH="$(dpkg --print-architecture)" && \
    KUBECTL_VERSION="v1.36.2" && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl"        -o /build/bin/kubectl && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl.sha256" -o /tmp/kubectl.sha256 && \
    echo "$(cat /tmp/kubectl.sha256)  /build/bin/kubectl" | sha256sum -c && \
    chmod +x /build/bin/kubectl && \
    rm /tmp/kubectl.sha256 && \
    HELM_VERSION="4.2.2" && \
    ARCH="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" && \
    HELM_ARCHIVE="helm-v${HELM_VERSION}-linux-${ARCH}.tar.gz" && \
    curl -fsSL "https://get.helm.sh/${HELM_ARCHIVE}" -o "/tmp/${HELM_ARCHIVE}" && \
    curl -fsSL "https://get.helm.sh/${HELM_ARCHIVE}.sha256sum" -o "/tmp/${HELM_ARCHIVE}.sha256sum" && \
    (cd /tmp && sha256sum -c "${HELM_ARCHIVE}.sha256sum") && \
    tar -xz --strip-components=1 -C /build/bin -f "/tmp/${HELM_ARCHIVE}" "linux-${ARCH}/helm" && \
    rm "/tmp/${HELM_ARCHIVE}" "/tmp/${HELM_ARCHIVE}.sha256sum" && \
    KUSTOMIZE_VERSION="5.8.1" && \
    ARCH="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" && \
    KUSTOMIZE_ARCHIVE="kustomize_v${KUSTOMIZE_VERSION}_linux_${ARCH}.tar.gz" && \
    curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize/v${KUSTOMIZE_VERSION}/${KUSTOMIZE_ARCHIVE}" -o "/tmp/${KUSTOMIZE_ARCHIVE}" && \
    curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize/v${KUSTOMIZE_VERSION}/checksums.txt" -o /tmp/kustomize.checksums.txt && \
    (cd /tmp && grep "${KUSTOMIZE_ARCHIVE}$" kustomize.checksums.txt | sha256sum -c -) && \
    tar -xz -C /build/bin -f "/tmp/${KUSTOMIZE_ARCHIVE}" kustomize && \
    rm "/tmp/${KUSTOMIZE_ARCHIVE}" /tmp/kustomize.checksums.txt

# ── Rust builder ─────────────────────────────────────────────────────
FROM debian:trixie-slim AS rust-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install to /home/aibox paths regardless of builder HOME (which is /root)
ENV CARGO_HOME=/home/aibox/.cargo RUSTUP_HOME=/home/aibox/.rustup

# S7 — BR-SEC-HARDEN: download rustup-init binary and verify SHA-256 before
# executing, replacing the previous curl-pipe-sh pattern.
# The sha256 file is published by the Rust project alongside each rustup-init:
#   https://static.rust-lang.org/rustup/dist/<arch>/rustup-init.sha256
# The binary is served over HTTPS from static.rust-lang.org (CDN-backed) and
# the checksum ties the download to the binary actually shipped by the project.
RUN ARCH="$(uname -m)" && \
    curl --proto '=https' --tlsv1.2 -fsSL \
      "https://static.rust-lang.org/rustup/dist/${ARCH}-unknown-linux-gnu/rustup-init" \
      -o /tmp/rustup-init && \
    curl --proto '=https' --tlsv1.2 -fsSL \
      "https://static.rust-lang.org/rustup/dist/${ARCH}-unknown-linux-gnu/rustup-init.sha256" \
      -o /tmp/rustup-init.sha256 && \
    (cd /tmp && sha256sum -c rustup-init.sha256) && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y \
      --default-toolchain 1.96.1 \
      --component clippy \
      --component rustfmt && \
    rm /tmp/rustup-init /tmp/rustup-init.sha256

ENV PATH="/home/aibox/.cargo/bin:${PATH}"

RUN cargo install cargo-audit

RUN install -d /usr/local/bin && \
    for bin in /home/aibox/.cargo/bin/*; do \
      ln -sf "$bin" "/usr/local/bin/$(basename "$bin")"; \
    done

# Pre-install the x86_64 cross-compilation target in the builder where
# rustup can freely download components (no directory or permission issues).
RUN rustup target add x86_64-unknown-linux-gnu


