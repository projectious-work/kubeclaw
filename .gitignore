# =============================================================================
# Project Specific
# =============================================================================

.root/
scratch.txt
.claude


# =============================================================================
# OpenTofu / Terraform
# =============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional - some teams commit this)
.terraform.lock.hcl

# =============================================================================
# SSH Keys (generated)
# =============================================================================
*.pem
*_key
*.key

# =============================================================================
# OS Generated Files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Ansible
# =============================================================================

# Auto-generated inventory (regenerated from tofu state)
ansible/inventory.ini

# Retry files
ansible/*.retry
ansible/playbooks/*.retry

# Fact cache
ansible/.facts/
ansible/fact_cache/

# Vault password files
ansible/.vault_pass
ansible/vault_password

# Custom variables (may contain secrets)
ansible/group_vars/all/vault.yml
ansible/host_vars/*/vault.yml

# =============================================================================
# MkDocs
# =============================================================================
site/

# =============================================================================
# IDE
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
